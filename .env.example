# Template for /etc/ci-runner-console.env on the host (root-owned, mode 0600).
# Never commit real values — this file exists to document the shape only.

# ---------------------------------------------------------------- server
HOST=0.0.0.0
PORT=8080
# The externally reachable origin. Used to build the OIDC redirect URI and to
# check the Origin header on mutations, so it must match exactly.
PUBLIC_BASE_URL=https://ci-runners.example.com
# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_SECONDS=28800

# ------------------------------------------------------------------ OIDC
OIDC_ISSUER=https://auth.example.com/application/o/ci-runners/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional second gate on top of Authentik's own application binding.
OIDC_ALLOWED_GROUPS=CI Runners

# ---------------------------------------------------------------- GitHub
# Prefer a fine-grained PAT scoped to just this target with
# "Self-hosted runners: read and write" (org) or "Administration: read and write"
# (repo). GITHUB_TOKEN_FILE is preferred over GITHUB_TOKEN in production.
GITHUB_TOKEN=
GITHUB_SCOPE=repo
GITHUB_OWNER=
# Required when GITHUB_SCOPE=repo.
GITHUB_REPO=
# Only meaningful when GITHUB_SCOPE=org.
#GITHUB_RUNNER_GROUP=

# ------------------------------------------------------------- runner VM
RUNNER_VM_HOST=192.168.10.96
RUNNER_VM_PORT=22
RUNNER_VM_USER=runner
# Key pinned to the ci-runner-ctl-ssh forced command on the VM.
RUNNER_VM_KEY_PATH=/etc/ci-runner-console/ssh-key
# Pinned host key: ssh-keyscan -t ed25519 <host>
RUNNER_VM_HOST_KEY=

# ---------------------------------------------------------------- runners
# Sensible ceiling for a 4 vCPU / 12 GiB VM. Must not exceed MAX_RUNNERS in
# /etc/ci-runner-ctl.conf on the VM, which enforces the same limit independently.
RUNNER_CAP=3
RUNNER_DEFAULT_LABELS=
# Runners this console must never modify, comma separated.
RUNNER_PROTECTED_NAMES=

# ------------------------------------------------------------------ misc
AUDIT_LOG_PATH=/var/lib/ci-runner-console/audit.jsonl
LOG_LEVEL=info
