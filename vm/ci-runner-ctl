#!/bin/bash
# ci-runner-ctl — the only privileged operation the control plane may perform on this VM.
#
# Runs as root. Every subcommand is parameterised and every parameter is validated
# here as well as in the SSH wrapper, so a bug or bypass in one layer is not sufficient
# on its own. Nothing from the caller is ever passed to a shell for evaluation.
#
# Output is a single JSON document on stdout. Diagnostics go to stderr.

set -euo pipefail
umask 022

CONF=/etc/ci-runner-ctl.conf
RUNNERS_DIR=/opt/runners
LEGACY_DIR=/opt/actions-runner
DIST_DIR=/opt/runner-dist
RUNNER_USER=runner

RUNNER_VERSION=2.336.0
RUNNER_SHA256=04cf0be1aff4c3ec3554466c39124ca250e3effd8873bb7e8d68535aa9505d5d
MAX_RUNNERS=3

die() { printf '%s\n' "{\"ok\":false,\"error\":$(json_str "$1")}"; exit "${2:-1}"; }

json_str() { python3 -c 'import json,sys;print(json.dumps(sys.argv[1]))' "$1"; }

# ---------------------------------------------------------------- validation

# GitHub runner names: letters, digits, dot, dash, underscore. Must start
# alphanumeric. Bounded length. This is also what makes $RUNNERS_DIR/$name safe.
valid_name() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$ ]]; }
valid_labels() { [[ $1 =~ ^[A-Za-z0-9._-]{1,39}(,[A-Za-z0-9._-]{1,39}){0,19}$ ]]; }
valid_url() { [[ $1 =~ ^https://github\.com/[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)?$ ]]; }
valid_group() { [[ $1 =~ ^[A-Za-z0-9._\ -]{1,64}$ ]]; }
valid_lines() { [[ $1 =~ ^[0-9]{1,4}$ ]]; }

require_name() {
  valid_name "$1" || die "invalid runner name"
  # Belt and braces: reject anything that could escape the runners directory even
  # if the regex above were ever loosened.
  [[ $1 != *..* && $1 != */* ]] || die "invalid runner name"
}

# Read a short-lived GitHub token from stdin. Never appears in argv, never logged,
# never written to disk by us.
read_token() {
  local t
  IFS= read -r -t 10 -n 257 t || true
  [[ -n ${t:-} ]] || die "expected token on stdin"
  [[ $t =~ ^[A-Za-z0-9._-]{10,255}$ ]] || die "malformed token"
  printf '%s' "$t"
}

# Bound privileged subprocesses, including descendants left behind by scripts.
systemctl() { timeout -k 5 30 systemctl "$@"; }
journalctl() { timeout -k 5 30 journalctl "$@"; }

safe_dir() {
  [[ -d $1 && ! -L $1 && $(realpath -e -- "$1") == "$1" ]]
}

trusted_path() {
  [[ ! -L $1 && $(stat -c %u -- "$1") == "$EUID" ]] &&
    (( (8#$(stat -c %a -- "$1") & 0022) == 0 ))
}

if [[ -e $CONF || -L $CONF ]]; then
  [[ -f $CONF ]] && trusted_path "$CONF" || die "unsafe controller configuration"
  # shellcheck source=/dev/null
  source "$CONF"
fi

# Metadata is runner-writable, so it must never select an arbitrary system unit.
valid_unit() { [[ $1 =~ ^actions\.runner\.[A-Za-z0-9._-]+\.service$ ]]; }

configure() {
  local d=$1 token=$2; shift 2
  # The runner supports VSO_AGENT_INPUT_TOKEN. Keep it out of argv and diagnostics.
  printf '%s\n' "$token" | timeout -k 5 120 sudo -u "$RUNNER_USER" -H bash -c '
    IFS= read -r VSO_AGENT_INPUT_TOKEN
    export VSO_AGENT_INPUT_TOKEN
    cd -- "$1" || exit
    shift
    exec ./config.sh "$@"
  ' bash "$d" "$@" 9>&- >/dev/null 2>&1
}

# ---------------------------------------------------------------- discovery

# Echoes "dir<TAB>name<TAB>unit" for each runner instance present on this VM.
# Count managed directories even after a failed unpack or runner-owned file deletion.
enumerate() {
  local d name unit
  for d in "$LEGACY_DIR" "$RUNNERS_DIR"/*; do
    safe_dir "$d" || continue
    [[ $d != "$LEGACY_DIR" || -x $d/config.sh && ! -L $d/config.sh ]] || continue
    name=''
    [[ $d == "$LEGACY_DIR" ]] && name=$(python3 -c '
import json,sys,os,stat
try:
    fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd) as f:
        assert stat.S_ISREG(os.fstat(f.fileno()).st_mode)
        print(json.loads(f.read(65536)).get("agentName",""))
except Exception:
    print("")' "$d/.runner" 2>/dev/null || true)
    valid_name "$name" && [[ $name != *..* ]] || name=$(basename "$d")
    valid_name "$name" && [[ $name != *..* ]] || continue
    unit=''
    unit=$(unit_for "$d" || true)
    printf '%s\t%s\t%s\n' "$d" "$name" "$unit"
  done
}

dir_for() {
  local want=$1 d n u
  while IFS=$'\t' read -r d n u; do
    [[ $n == "$want" ]] && { printf '%s' "$d"; return 0; }
  done < <(enumerate)
  return 1
}

unit_for() {
  local d=$1
  local unit=actions.runner.console.${d##*/}.service
  if [[ ! -f /etc/systemd/system/$unit ]]; then
    [[ -f $d/.service && ! -L $d/.service && $(stat -c %s "$d/.service") -le 255 ]] || return 1
    unit=$(python3 -c '
import os,stat,sys
fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
with os.fdopen(fd) as f:
    assert stat.S_ISREG(os.fstat(f.fileno()).st_mode)
    print(f.read(256).rstrip("\n"))' "$d/.service" 2>/dev/null) || return 1
  fi
  valid_unit "$unit" || return 1
  # Runner metadata is only a hint. Authority comes from a root-owned unit bound
  # to this exact directory and unprivileged account.
  python3 - "$unit" "$d" "$RUNNER_USER" <<'PYUNIT' || return 1
import os, stat, sys, configparser
unit, directory, user = sys.argv[1:]
try:
    fd = os.open("/etc/systemd/system/" + unit, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd) as f:
        st = os.fstat(f.fileno())
        assert stat.S_ISREG(st.st_mode) and st.st_uid == 0 and not st.st_mode & 0o022
        content = f.read(65537)
        assert len(content) <= 65536
        c = configparser.ConfigParser(interpolation=None, strict=True, delimiters=("=",))
        c.optionxform = str
        c.read_string(content)
    assert not c.defaults()
    assert c["Service"]["WorkingDirectory"] == directory
    assert c["Service"]["User"] == user
    assert c["Service"]["ExecStart"] == directory + "/runsvc.sh"
    assert not os.path.lexists("/etc/systemd/system/" + unit + ".d")
except Exception:
    sys.exit(1)
PYUNIT
  printf '%s' "$unit"
}

# `systemctl is-active` prints the state and *also* exits non-zero for anything
# that is not active, so `cmd || echo unknown` would emit both words. Capture
# first, then fall back only when there was genuinely no output.
unit_active() {
  local state
  state=$(systemctl is-active "$1" 2>/dev/null) || true
  printf '%s' "${state:-unknown}"
}

# ---------------------------------------------------------------- subcommands

cmd_list() {
  local d n u active enabled substate since
  {
    printf '{"ok":true,"instances":['
    local first=1
    while IFS=$'\t' read -r d n u; do
      [[ $first == 1 ]] || printf ','
      first=0
      active=''; enabled=''; substate=''; since=''
      if [[ -n $u ]]; then
        active=$(systemctl is-active "$u" 2>/dev/null || true)
        enabled=$(systemctl is-enabled "$u" 2>/dev/null || true)
        substate=$(systemctl show -p SubState --value "$u" 2>/dev/null || true)
        since=$(systemctl show -p ActiveEnterTimestamp --value "$u" 2>/dev/null || true)
      fi
      python3 - "$d" "$n" "$u" "$active" "$enabled" "$substate" "$since" <<'PY'
import json,sys,os
d,n,u,active,enabled,substate,since = sys.argv[1:8]
# .credentials is the actual registration; .runner alone only records intent, and
# treating the two as equivalent would merge a half-configured directory with a
# real GitHub registration of the same name.
registered = os.path.exists(os.path.join(d,".credentials"))
print(json.dumps({
  "dir": d, "name": n, "unit": u or None,
  "registered": registered,
  "serviceInstalled": bool(u) and os.path.exists("/etc/systemd/system/"+u),
  "active": active or None, "enabled": enabled or None,
  "subState": substate or None, "activeSince": since or None,
  "legacy": d == os.environ.get("LEGACY_DIR","/opt/actions-runner"),
}), end="")
PY
    done < <(enumerate)
    printf ']}\n'
  }
}

cmd_headroom() {
  local count
  count=$(enumerate | wc -l)
  python3 - "$count" "$MAX_RUNNERS" <<'PY'
import json,os,sys,shutil
count,cap = int(sys.argv[1]), int(sys.argv[2])
mem = {}
for line in open("/proc/meminfo"):
    k,_,v = line.partition(":")
    mem[k] = int(v.split()[0]) * 1024
total,used,free = shutil.disk_usage("/")
load1,load5,load15 = os.getloadavg()
print(json.dumps({
  "ok": True,
  "cpus": os.cpu_count(),
  "load": {"one": round(load1,2), "five": round(load5,2), "fifteen": round(load15,2)},
  "memory": {"totalBytes": mem.get("MemTotal",0), "availableBytes": mem.get("MemAvailable",0)},
  "disk": {"totalBytes": total, "freeBytes": free},
  "instances": count,
  "cap": cap,
  "remaining": max(0, cap - count),
}))
PY
}

cmd_status() {
  local name=$1 d u
  require_name "$name"
  d=$(dir_for "$name") || die "no such runner instance: $name"
  u=$(unit_for "$d" || true)
  python3 - "$d" "$name" "$u" \
    "$([[ -n $u ]] && systemctl is-active "$u" 2>/dev/null || true)" \
    "$([[ -n $u ]] && systemctl is-enabled "$u" 2>/dev/null || true)" <<'PY'
import json,sys,os
d,name,u,active,enabled = sys.argv[1:6]
print(json.dumps({"ok":True,"name":name,"dir":d,"unit":u or None,
  "active":active or None,"enabled":enabled or None,
  "registered": os.path.exists(os.path.join(d,".credentials"))}))
PY
}

cmd_logs() {
  local name=$1 lines=${2:-200} d u
  require_name "$name"
  valid_lines "$lines" || die "invalid line count"
  d=$(dir_for "$name") || die "no such runner instance: $name"
  u=$(unit_for "$d") || die "runner $name has no installed service"
  journalctl -u "$u" -n "$lines" --no-pager -o short-iso 2>/dev/null \
    | python3 -c 'import json,sys;print(json.dumps({"ok":True,"lines":sys.stdin.read().splitlines()}))'
}

svc_action() {
  local name=$1 action=$2 d u
  require_name "$name"
  d=$(dir_for "$name") || die "no such runner instance: $name"
  u=$(unit_for "$d") || die "runner $name has no installed service"
  systemctl "$action" "$u" >&2 || die "systemctl $action failed for $u"
  # enable/disable alongside start/stop so the state survives a VM reboot.
  case $action in
    start)   systemctl enable "$u" >&2 2>/dev/null || die "service enable failed" ;;
    stop)    systemctl disable "$u" >&2 2>/dev/null || die "service disable failed" ;;
  esac
  printf '{"ok":true,"name":%s,"unit":%s,"action":%s,"active":%s}\n' \
    "$(json_str "$name")" "$(json_str "$u")" "$(json_str "$action")" \
    "$(json_str "$(unit_active "$u")")"
}

cmd_create() {
  local name=$1 labels=$2 url=$3 group=${4:-}
  require_name "$name"
  # No extra labels is a legitimate choice: the runner still gets GitHub's
  # automatic self-hosted/Linux/X64 set.
  [[ -z $labels ]] || valid_labels "$labels" || die "invalid labels"
  valid_url "$url" || die "invalid GitHub URL"
  [[ -z $group ]] || valid_group "$group" || die "invalid runner group"

  local count
  count=$(enumerate | wc -l)
  (( count < MAX_RUNNERS )) || die "runner cap reached ($count/$MAX_RUNNERS)"

  dir_for "$name" >/dev/null 2>&1 && die "a runner instance named $name already exists"

  local dist=$DIST_DIR/actions-runner-linux-x64-${RUNNER_VERSION}.tar.gz
  safe_dir "$DIST_DIR" && trusted_path "$DIST_DIR" && [[ -f $dist ]] && trusted_path "$dist" || die "no trusted runner distribution"
  printf '%s  %s\n' "$RUNNER_SHA256" "$dist" | sha256sum -c - >/dev/null 2>&1 || die "runner distribution checksum mismatch"

  local token
  token=$(read_token)

  local d=$RUNNERS_DIR/$name
  mkdir -- "$d" || die "instance path already exists"
  # Fresh unpack every time. Never copy another instance's directory — .credentials
  # and .runner are per-registration and sharing them corrupts both runners.
  if ! timeout -k 5 120 tar xzf "$dist" -C "$d"; then
    rm -rf -- "$d"
    die "runner extraction failed"
  fi
  chown -hR "$RUNNER_USER":"$RUNNER_USER" "$d" || die "runner ownership failed; instance retained"

  local args=(--unattended --url "$url" --name "$name"
              --work _work --replace=false)
  # config.sh rejects an empty --labels value, so omit the flag entirely rather
  # than passing "".
  [[ -n $labels ]] && args+=(--labels "$labels")
  [[ -n $group ]] && args+=(--runnergroup "$group")

  if ! configure "$d" "$token" "${args[@]}"; then
    die "config.sh failed; instance retained for cleanup"
  fi

  # Never execute runner-owned svc.sh as root.
  local u=actions.runner.console.$name.service
  local unit_path=/etc/systemd/system/$u
  [[ ! -e $unit_path && ! -L $unit_path ]] || die "service path already exists"
  ( set -o noclobber
    cat > "$unit_path" <<EOF
[Unit]
Description=GitHub Actions runner $name
After=network.target
[Service]
User=$RUNNER_USER
WorkingDirectory=$d
ExecStart=$d/runsvc.sh
KillMode=control-group
TimeoutStopSec=30
[Install]
WantedBy=multi-user.target
EOF
  ) || die "service creation failed"
  if ! systemctl daemon-reload || ! systemctl enable --now "$u"; then
    # Retain registration and files so failure remains visible and retryable.
    die "service install/start failed; instance retained for cleanup"
  fi
  printf '{"ok":true,"name":%s,"dir":%s,"unit":%s,"active":%s}\n' \
    "$(json_str "$name")" "$(json_str "$d")" "$(json_str "$u")" \
    "$(json_str "$([[ -n $u ]] && unit_active "$u" || echo unknown)")"
}

cmd_remove() {
  local name=$1 d u token
  require_name "$name"
  d=$(dir_for "$name") || die "no such runner instance: $name"
  [[ $d != "$LEGACY_DIR" ]] || die "refusing to remove the pre-existing $LEGACY_DIR instance"

  token=$(read_token)

  if ! u=$(unit_for "$d"); then
    [[ ! -e $d/.service && ! -L $d/.service && ! -e /etc/systemd/system/actions.runner.console.${d##*/}.service && ! -L /etc/systemd/system/actions.runner.console.${d##*/}.service ]] || die "unsafe service metadata; instance retained"
    u=''
  fi
  if [[ -n $u ]]; then
    systemctl stop "$u" >&2 || die "service stop failed; instance retained"
    systemctl disable "$u" >&2 || die "service disable failed; instance retained"
    [[ ! -L /etc/systemd/system/$u ]] || die "unsafe service path"
    rm -f -- "/etc/systemd/system/$u" || die "service uninstall failed; instance retained"
    # Unlink the marker itself, never follow a runner-owned symlink.
    rm -f -- "$d/.service" || die "service marker cleanup failed; instance retained"
    systemctl daemon-reload || die "service reload failed; instance retained"
  fi
  # The runner refuses deregistration while its service marker exists.
  # Keep registration metadata on failure so a retry can finish cleanup.
  local deregistered=true
  if [[ -e $d/.runner || -L $d/.runner || -e $d/.credentials || -L $d/.credentials ]]; then
    configure "$d" "$token" remove || die "deregistration failed; instance retained"
  fi
  rm -rf "$d"
  printf '{"ok":true,"name":%s,"deregisteredLocally":%s}\n' "$(json_str "$name")" "$deregistered"
}

# ---------------------------------------------------------------- dispatch

[[ $EUID -eq 0 ]] || die "ci-runner-ctl must run as root"
[[ $# -ge 1 ]] || die "no subcommand"

[[ $RUNNER_USER =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "invalid runner user"
runner_uid=$(id -u -- "$RUNNER_USER") || die "runner user does not exist"
[[ $runner_uid =~ ^[0-9]+$ && $runner_uid -ne 0 ]] || die "runner user must be unprivileged"
[[ $RUNNER_VERSION =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && $RUNNER_SHA256 =~ ^[a-fA-F0-9]{64}$ ]] || die "invalid runner distribution pin"
[[ $MAX_RUNNERS =~ ^[1-9][0-9]{0,3}$ ]] || die "invalid runner cap"
safe_dir "$RUNNERS_DIR" && trusted_path "$RUNNERS_DIR" || die "unsafe runners directory"
# Serialize discovery and mutation so cap checks and removals see stable state.
exec 9>/run/ci-runner-ctl.lock
flock -w 10 9 || die "another runner operation is in progress"
sub=$1; shift
case $sub in
  list)     [[ $# -eq 0 ]] || die "list takes no arguments"; cmd_list ;;
  headroom) [[ $# -eq 0 ]] || die "headroom takes no arguments"; cmd_headroom ;;
  status)   [[ $# -eq 1 ]] || die "status takes 1 argument"; cmd_status "$1" ;;
  logs)     [[ $# -ge 1 && $# -le 2 ]] || die "logs takes 1-2 arguments"; cmd_logs "$@" ;;
  start|stop|restart)
            [[ $# -eq 1 ]] || die "$sub takes 1 argument"; svc_action "$1" "$sub" ;;
  create)   [[ $# -ge 3 && $# -le 4 ]] || die "create takes 3-4 arguments"; cmd_create "$@" ;;
  remove)   [[ $# -eq 1 ]] || die "remove takes 1 argument"; cmd_remove "$1" ;;
  *)        die "unknown subcommand" ;;
esac
